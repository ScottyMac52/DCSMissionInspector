Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\Directory\shell\DCS.PackMIZ]
@="Pack to .miz"
"Icon"="zipfldr.dll"

[HKEY_CLASSES_ROOT\Directory\shell\DCS.PackMIZ\command]
@="powershell.exe -WindowStyle Hidden -Command \"& { Compress-Archive -Path '$($args[0])\\*' -DestinationPath '$($args[0]).miz' -Force }\" \"%1\""